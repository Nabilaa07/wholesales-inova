# Salin file ini menjadi ".env" lalu isi sesuai lingkungan kamu.
# JANGAN commit file .env ke GitHub (sudah ada di .gitignore).

# ---------- DBMS 1: MySQL (data transaksi / fakta penjualan) ----------
# Lokal (XAMPP): host 127.0.0.1, port 3306, user root, password kosong
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=innova_sales
# Isi true untuk database cloud yang mewajibkan TLS (mis. TiDB Cloud)
MYSQL_SSL=false

# ---------- DBMS 2: PostgreSQL (katalog varian, kalender, referensi) ----------
# Lokal (Postgres.app): host localhost, port 5432, user = username macOS kamu, password kosong
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=innova_catalog
# prefer (lokal) | require (Neon/Supabase/cloud)
PG_SSLMODE=prefer
