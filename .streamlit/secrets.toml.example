# Contoh isi "Secrets" di Streamlit Community Cloud (Settings -> Secrets).
# Untuk dev lokal file ini TIDAK dipakai; pakai .env. Jangan commit secrets.toml asli.

MYSQL_HOST = "gateway01.xxxx.prod.aws.tidbcloud.com"
MYSQL_PORT = "4000"
MYSQL_USER = "xxxxxxxx.root"
MYSQL_PASSWORD = "ganti-dengan-password"
MYSQL_DATABASE = "innova_sales"
MYSQL_SSL = "true"

PG_HOST = "ep-xxxx.ap-southeast-1.aws.neon.tech"
PG_PORT = "5432"
PG_USER = "neondb_owner"
PG_PASSWORD = "ganti-dengan-password"
PG_DATABASE = "innova_catalog"
